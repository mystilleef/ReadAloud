{
  "name": "readaloud",
  "author": "Lateef Alabi-Oki <mystilleef@gmail.com>",
  "license": "GPL-3.0-or-later",
  "version": "0.44.19",
  "type": "module",
  "repository": "https://github.com/mystilleef/ReadAloud",
  "description": "An extension to read aloud selected text in Google Chrome",
  "keywords": [
    "chrome-extension",
    "web-extension",
    "typescript",
    "read aloud"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "migrate": "biome migrate --write",
    "precheck": "npm run migrate && npm run clean",
    "check": "biome check --write --unsafe --error-on-warnings . && tsc --noEmit",
    "prebuild": "npm run check",
    "build": "tsc -b && vite build",
    "prewatch": "npm run test",
    "watch": "vite",
    "preview": "vite preview",
    "prerelease": "npm run test",
    "release": "tsx scripts/release.ts",
    "predeploy": "npm run test",
    "deploy": "tsx scripts/deploy.ts",
    "test-auth": "tsx scripts/service-account-auth.ts",
    "pretest": "npm run build",
    "test": "vitest run",
    "precoverage": "npm run build",
    "coverage": "vitest run --coverage",
    "verify": "npm run test"
  },
  "dependencies": {
    "@extend-chrome/messages": "^1.2.2",
    "@extend-chrome/storage": "^1.5.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/web": "^0.0.358",
    "@vitest/coverage-v8": "^5.0.3",
    "chalk": "^6.0.1",
    "chrome-webstore-upload": "^6.0.1",
    "execa": "^10.1.0",
    "google-auth-library": "^11.2.0",
    "jsdom": "^30.1.2",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.5",
    "rollup-plugin-zip": "^1.0.3",
    "semver": "^7.8.5",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-biome": "^1.2.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "vite-plugin-biome": {
      "@biomejs/biome": "$@biomejs/biome"
    },
    "@crxjs/vite-plugin": {
      "rollup": "2.80.0"
    },
    "vite-plugin-static-copy": {
      "chokidar": "^4.0.3"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
